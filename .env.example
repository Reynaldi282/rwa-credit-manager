# ─────────────────────────────────────────────────────────────────────────────
# RWA Credit Manager — environment variables (copy to .env / .env.local; NEVER commit real keys)
# Testnet only. Do not use a wallet that holds real funds.
# ─────────────────────────────────────────────────────────────────────────────

# ── Contracts (Foundry, contracts/) ──────────────────────────────────────────
# Sepolia RPC used by `forge script --rpc-url sepolia` and the fork tests
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# For `--verify` on Etherscan (https://etherscan.io/myapikey)
ETHERSCAN_API_KEY=
# Prefer an encrypted keystore over a raw key:  cast wallet import deployer --interactive
#   forge script script/DeploySepolia.s.sol --rpc-url sepolia --broadcast --account deployer --verify

# ── Keeper (services/keeper) ─────────────────────────────────────────────────
KEEPER_CHAIN_ID=11155111            # 31337 = local Anvil, 11155111 = Sepolia
KEEPER_RPC_URL=                     # required on Sepolia
KEEPER_PRIVATE_KEY=                 # dedicated low-value Sepolia keeper wallet (0x + 64 hex)
# KEEPER_UNLOCKED_ADDRESS=          # Anvil only: send from an unlocked Anvil account instead of a key
KEEPER_POLL_INTERVAL_MS=15000
KEEPER_PORT=8787
KEEPER_CORS_ORIGINS=http://localhost:3000
# KEEPER_GUARD_ADDRESS=             # override the address from contracts/deployments/<chainId>.json
# KEEPER_LOG_LEVEL=info

# ── Dashboard (apps/web/.env.local) — see apps/web/.env.example ───────────────
NEXT_PUBLIC_DEFAULT_CHAIN_ID=11155111
NEXT_PUBLIC_ENABLE_LOCAL_CHAIN=false
NEXT_PUBLIC_ENABLE_DEV_WALLET=false
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_ANVIL_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_KEEPER_URL=
