# ── RWA Credit Manager dashboard ─────────────────────────────────────────────
# Chain the dashboard reads when no wallet is connected: 11155111 (Sepolia) or 31337 (local Anvil)
NEXT_PUBLIC_DEFAULT_CHAIN_ID=11155111
# Show the local Anvil chain (31337) in the network list
NEXT_PUBLIC_ENABLE_LOCAL_CHAIN=false
# LOCAL ONLY: offer an "Anvil dev wallet" connector backed by an unlocked Anvil account (no key in the app)
NEXT_PUBLIC_ENABLE_DEV_WALLET=false
# RPC endpoints used for reads (wallet writes go through the user's wallet)
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_ANVIL_RPC_URL=http://127.0.0.1:8545
# Optional keeper HTTP API for the "Run keeper now" button (services/keeper)
NEXT_PUBLIC_KEEPER_URL=
# Event history window and eth_getLogs chunk size (public RPCs limit block ranges)
NEXT_PUBLIC_HISTORY_LOOKBACK_BLOCKS=50000
NEXT_PUBLIC_LOG_CHUNK_BLOCKS=9000
